#!/bin/sh
# Pre-commit hook: fast quality gates before each commit.
# Activate: git config core.hooksPath .githooks
# Full gate (types, tests, coverage, performance): uv run poe check

set -e

if command -v uv >/dev/null 2>&1; then
  echo "[pre-commit] ruff format / lint, vendored library"
  uv run --quiet poe format-check
  uv run --quiet poe lint
  uv run --quiet poe vendor-check
else
  echo "[pre-commit] WARNING: uv not found; skipping Python checks"
fi

STAGED_MD=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
if [ -n "$STAGED_MD" ] && command -v npx >/dev/null 2>&1; then
  echo "[pre-commit] markdownlint"
  npx --yes markdownlint-cli2
fi
